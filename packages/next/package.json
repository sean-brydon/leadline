{
  "name": "@leadline/next",
  "version": "0.0.1",
  "description": "See a Next.js app in Leadline while you develop it: routes, server actions, renders, queries, users and the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sean-brydon/leadline.git",
    "directory": "packages/next"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\"",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@leadline/node": "link:../node",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
